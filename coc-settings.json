{
  "callHierarchy.splitCommand": "bel 10sp",
  "clojure.enable": true,
  "clojure.executable": "clojure-lsp",
  "clojure.initialization-options.semantic-tokens?": true,
  "clojure.initialization-options.copy-kondo-configs?": true,
  "clojure.initialization-options.log-path": "/tmp/clojure-lsp.out",
  "clojure.initialization-options.use-metadata-for-privacy?": true,
  "clojure.initialization-options.hover": {
    "clojuredocs": true,
    "arity-on-same-line?": false
  },
  "clojure.initialization-options.java": {
    "download-jdk-source?": true
  },
  "clojure.lsp-check-on-start": false,
  "clojure.startup-message": true,
  "clojure.trace.server": "verbose",
  "[clojure]": {
    "semanticTokens.enable": true
  },
  "javascript.validate.enable": false,
  "tsserver.enable": true,
  "tsserver.disableAutomaticTypeAcquisition": false,
  "tsserver.implicitProjectConfig.module": "CommonJS",
  "tsserver.implicitProjectConfig.target": "ES2022",
  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": true,
  "typescript.format.enable": false,
  "extensions.updateCheck": "daily",
  "coc.preferences.messageLevel": "error",
  "workspace.rootPatterns": [
    ".git",
    ".projections.json",
    "bb.edn",
    "deps.edn",
    "project.clj",
    "shadow-cljs.edn"
  ],
  "workspace.ignoredFolders": [
      "$HOME",
      "$HOME/.cargo/**",
      "$HOME/.rustup/**"
  ],
  "coc.preferences.useQuickfixForLocations": false,
  "codeLens.enable": true,
  "codeLens.position": "eol",
  "codeLens.separator": "->",
  "hover.floatConfig": { "winblend": 0 },
  "inlayHint.display": false,
  "signature.enable": true,
  "signature.floatConfig": { "winblend": 0 },
  "diagnostic.displayByAle": false,
  "diagnostic.floatConfig": {
    "border": true,
    "maxWidth": 256,
    "winblend": 0
  },
  "suggest.detailField": "abbr",
  "suggest.floatConfig": { "winblend": 0 },
  "suggest.minTriggerInputLength": 2,
  "suggest.noselect": true,
  "suggest.triggerCompletionWait": 10,
  "suggest.enableFloat": false,
  "suggest.maxCompleteItemCount": 15,
  "suggest.removeDuplicateItems": true,
  "suggest.snippetIndicator": "->",
  "suggest.completionItemKindLabels": {
    "class": "פּ",
    "color": "",
    "constant": "",
    "constructor": "",
    "enum": "練",
    "enumMember": "",
    "event": "",
    "field": "",
    "file": "",
    "folder": "ﱮ",
    "function": "",
    "interface": "蘒",
    "keyword": "",
    "method": "",
    "module": "",
    "operator": "",
    "property": "",
    "reference": "",
    "snippet": "",
    "struct": "",
    "text": "",
    "typeParameter": "",
    "unit": "塞",
    "value": "",
    "variable": ""
  },
  "json.schemaDownload.trustedDomains": {
    "https://www.schemastore.org": true
  }
}
